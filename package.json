{
  "name": "coupon-platform",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify:integration": "bun --no-env-file services/coupon-service/tests/verify-integration.ts",
    "dev": "turbo dev",
    "db:migrate": "bun run --cwd services/coupon-service db:migrate",
    "db:seed": "bun run --cwd services/coupon-service db:seed",
    "reporter:create": "bun run --cwd services/coupon-service reporter:create",
    "demo": "bun run --cwd apps/extension demo"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
