{
  "name": "@repo/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && bun run build.ts",
    "build:beta": "tsc --noEmit && bun run build.ts --target beta",
    "icons": "bun run build.ts --icons",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "demo": "bun run demo/server.ts",
    "test:e2e": "bun e2e/smoke.ts",
    "test:e2e:amazon": "bun e2e/amazon-reader.ts && bun e2e/amazon-checkout.ts && bun e2e/amazon-extension.ts",
    "browser:install": "playwright install chromium",
    "test:e2e:shopify": "bun e2e/shopify-checkout.ts && bun e2e/shopify-extension.ts",
    "test:e2e:prices": "bun e2e/price-alerts.ts",
    "test:live:prices": "bun e2e/price-alerts.ts --live"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.5",
    "@types/chrome": "^0.0.287",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2"
  }
}
