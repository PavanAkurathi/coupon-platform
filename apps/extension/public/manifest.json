{
  "manifest_version": 3,
  "name": "__PRODUCT_NAME__",
  "version": "0.5.0",
  "minimum_chrome_version": "140",
  "description": "Hold before you buy: warns when the same item is cheaper at another store, and finds cheaper Amazon sellers and coupons.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "Hold: check before you buy", "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
  },
  "content_scripts": [{ "matches": ["http://localhost/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src __API_ORIGIN__" }
}
