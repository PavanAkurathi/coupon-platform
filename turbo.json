{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {"dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["COUPON_API_ORIGIN", "PRICE_API_ORIGIN"]},
    "typecheck": {"dependsOn": ["^typecheck"], "outputs": []},
    "test": {"dependsOn": ["^build"], "outputs": []},
    "dev": {"cache": false, "persistent": true, "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "CORS_ORIGINS"]}
  }
}
