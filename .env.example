# Only needed when running the coupon service outside Docker.
DATABASE_URL=postgres://coupon:local-development-only@localhost:5432/coupons
REDIS_URL=redis://localhost:6379
PORT=3001
# Optional comma-separated allowed browser origins; extension requests use host permissions.
CORS_ORIGINS=http://localhost:4173
# Optional Compose host-port overrides when another project uses the defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Shopper confirmations older than this many days stop counting toward verification (1-365).
EVIDENCE_WINDOW_DAYS=30
# Only when a trusted proxy in front sets a client-address header (for example fly-client-ip or
# cf-connecting-ip). Never set it when clients can reach the service directly.
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=1
